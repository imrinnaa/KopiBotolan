# ===== Kredensial & pengaturan server (JANGAN di-commit ke Git) =====
# Salin file ini menjadi .env lalu sesuaikan isinya.

PORT=3000
NODE_ENV=development

# --- Database (SQLite) ---
DB_PATH=./data/kopi-botolan.sqlite

# --- Login admin ---
# Ganti sebelum dipakai sungguhan. Kata sandi disimpan sebagai hash (bukan teks asli).
ADMIN_USER=admin
ADMIN_PASS=botolan123
ADMIN_PASS_HASH=
SESSION_SECRET=ganti-dengan-teks-acak-panjang

# --- Opsional: MySQL (dipakai bila DB_DRIVER=mysql) ---
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=company_profile

# --- Info perusahaan (ditampilkan di halaman Beranda) ---
NAMA_PERUSAHAAN=Kopi Botolan
TAGLINE=Kopi peracikan tangan, sejinak langkah pulang.
